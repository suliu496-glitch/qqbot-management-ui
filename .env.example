# 首次使用复制为 .env，并自行填写；不要上传、截图或分享 .env。
MY_QQ=
MASTER_QQ=
SELF_NICK=
DEEPSEEK_API_KEY=
DEFAULT_CITY=
QQBOT_AUTO_DIGEST=0

# 可选：使用对应功能时自行填写
ZHIPU_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 一般保持本机地址，必须与 NapCat 的 OneBot 配置一致
NAP_CAT_HTTP=http://127.0.0.1:3000
NAP_CAT_WS=ws://127.0.0.1:3001
PERSONA_FILE=persona.txt
ROLES_FILE=roles.json
QQBOT_UI_ENABLED=1
QQBOT_UI_OPEN=1
